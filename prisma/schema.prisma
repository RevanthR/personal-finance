// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth ────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

// Gmail sync is gated by Google's own OAuth "Testing" publishing status —
// only emails manually added as test users in Google Cloud Console can
// complete the consent screen at all, everyone else hits Google's own
// cryptic "app hasn't completed verification" error with no path forward.
// This tracks the in-app side of getting past that: a user requests
// access, an admin adds them as a test user in Google Cloud Console (that
// step can't be automated via any API) and then approves here, which is
// what actually unlocks the real Connect Gmail button.
enum GmailSyncStatus {
  NONE
  REQUESTED
  APPROVED
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  role              Role               @default(USER)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  planType          String             @default("FREE")  // FREE | WEEKLY | MONTHLY | QUARTERLY | YEARLY
  planExpiry        DateTime?
  trialEndsAt       DateTime?
  gmailSyncStatus      GmailSyncStatus @default(NONE)
  gmailSyncRequestedAt DateTime?
  // Push tags with a notification currently showing somewhere (set when a
  // "notify" push is sent, cleared when the matching "close" push is sent).
  // Lets closePushForUser skip sending anything when there's nothing to
  // close — see src/lib/push.ts.
  activePushTags       String[]        @default([])
  accounts          Account[]
  sessions          Session[]
  months            Month[]
  templates         LineItemTemplate[]
  chitFunds         ChitFund[]
  creditCards       CreditCard[]
  cardStatements    CardStatement[]
  receivables       Receivable[]
  pushSubscriptions PushSubscription[]
  payments          Payment[]
  customCategories  CustomCategory[]
  gmailConnection   GmailConnection?
  parsedTransactions ParsedTransaction[]
  gmailSeenMessages  GmailSeenMessage[]
  gmailSenderReputations GmailSenderReputation[]
  merchantCategoryMemories MerchantCategoryMemory[]
  geminiUsageLogs   GeminiUsageLog[]
  carriedDebtSettlements CarriedDebtSettlement[]
}

// User-defined expense categories, reused (not retyped) across templates
// and ad-hoc items so a name can't drift into near-duplicates over time.
model CustomCategory {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime           @default(now())
  templates   LineItemTemplate[]
  adHocItems  AdHocItem[]
  receivables Receivable[]
  merchantMemories MerchantCategoryMemory[]

  @@unique([userId, name])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  planType          String   // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  amount            Int      // paise
  status            String   @default("CREATED") // CREATED | CAPTURED | FAILED
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Finance Core ─────────────────────────────────────────────────────────────

enum Category {
  HOUSE_MAINTENANCE
  LOAN
  CHIT_FUND
  CREDIT_CARD
  SAVINGS
  PERSONAL
  MISCELLANEOUS
  SALARY
  FREELANCE
  RENTAL
  BUSINESS
  INVESTMENTS
  OTHER_INCOME
}

enum Frequency {
  MONTHLY
  YEARLY
}

enum TemplateType {
  EXPENSE
  INCOME
}

enum AdHocType {
  INCOME
  EXPENSE
}

// Recurring line item template — one per type of payment
model LineItemTemplate {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  category         Category
  customCategory   String?
  customCategoryId String?
  customCategoryRef CustomCategory? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  amount           Float
  isFixed          Boolean        @default(true)
  dueDateDay       Int?
  isActive         Boolean        @default(true)
  foreClosedOn     DateTime?
  foreCloseAmount  Float?
  pendingAmount    Float?
  pendingFromMonth Int?
  pendingFromYear  Int?
  statementDay     Int?
  // CC only: the card's total credit line, for showing utilization
  // (spent / limit) — separate from any one cycle's bill amount.
  creditLimit      Float?
  frequency        Frequency      @default(MONTHLY)
  dueMonth         Int?
  templateType     TemplateType   @default(EXPENSE)
  endsOnMonth      Int?
  endsOnYear       Int?
  sortOrder        Int            @default(0)
  loanOriginalPrincipal   Float?
  loanInterestRate        Float?
  loanRateType            String?   // "FIXED" | "FLOATING"
  loanStartDate           DateTime?
  loanOutstandingOverride Float?
  createdAt        DateTime       @default(now())
  entries          MonthlyEntry[]
  paidViaCardFor   MonthlyEntry[] @relation("PaidViaCard")
  chitFund         ChitFund?
  creditCard       CreditCard?
  adHocCharges     AdHocItem[]
  carriedDebtSettlements CarriedDebtSettlement[]
}

// One record per calendar month per user
model Month {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  salaryIncome    Float          @default(0)
  freelanceIncome Float          @default(0)
  otherIncome     Float          @default(0)
  // Actual cash left over from the previous month (income - what was
  // actually paid out, not just committed), carried forward by setupMonth.
  // Frozen once the month is populated — never mutated afterward, so it stays
  // a true snapshot of what carried in. See carriedDebtPaid below for money
  // that moves during the month itself.
  openingBalance  Float          @default(0)
  // Real cash paid THIS month toward a bill that belongs to an earlier
  // month (a carried-over payable, or a credit card's carried-in debt paid
  // before its statement closes) — tracked separately from openingBalance
  // so that field can stay a frozen "what I started the month with" snapshot
  // instead of silently absorbing later-month payments and misreporting
  // what carried in.
  carriedDebtPaid Float          @default(0)
  isPopulated     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  entries         MonthlyEntry[]
  adHocItems      AdHocItem[]
  receivables     Receivable[]

  @@unique([userId, month, year])
}

// Instance of a template for a specific month
model MonthlyEntry {
  id              String           @id @default(cuid())
  monthId         String
  month           Month            @relation(fields: [monthId], references: [id], onDelete: Cascade)
  templateId      String
  template        LineItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  amount          Float
  isPaid          Boolean          @default(false)
  paidOn          DateTime?
  paidAmount      Float?
  cashbackAmount  Float?
  notes           String?
  statementAmount Float?
  billedAmount    Float?           // CC only: obligation at month open; used for carry-forward instead of amount
  // CC only: genuinely unpaid debt already billed in a prior, closed
  // statement — NOT last cycle's own new charges (those aren't debt until
  // their own statement closes). Always counts toward Pending even before
  // THIS cycle's statement closes. Never touched after creation.
  carriedInAmount Float?
  // CC only: the starting balance this cycle opened with (last cycle's
  // closed bill + any real carried debt), set once at month-open and never
  // touched again — see computeTemplateEntryAmount. Lets `amount` be
  // recomputed from scratch as openingAmount + this cycle's own AdHocItems
  // (cc-effects.ts's recomputePreCloseAmount) instead of drifting via
  // incremental +=/-= on every charge and repayment, the way it did before
  // this field existed (see the isCardRepayment investigation this field
  // came from — a card's live balance had quietly drifted a few rupees off
  // from what its own transaction history actually added up to).
  openingAmount   Float            @default(0)
  createdAt       DateTime         @default(now())
  // Non-CC only: which card actually settled this bill, if not cash/bank —
  // paying rent/insurance/an EMI with a credit card instead of cash. When
  // set, this entry's own cash contribution is deferred to whenever that
  // card's bill itself gets paid off (see billPaymentsAttributed below and
  // finance-utils.ts's cashCommitted/cashPaid).
  paidViaCardTemplateId String?
  paidViaCard           LineItemTemplate? @relation("PaidViaCard", fields: [paidViaCardTemplateId], references: [id], onDelete: SetNull)
  // CC only: how much of THIS card's own amount is really someone else's
  // bill routed through it (via paidViaCardTemplateId above), not genuine
  // card spend — excluded from Expenditure/category-breakdown totals (that
  // money is already counted once, under whichever bill actually spent it)
  // but still real money this card owes, so it stays in amount/billedAmount
  // and in cash-flow totals once the card itself gets paid off.
  billPaymentsAttributed Float @default(0)

  @@unique([monthId, templateId])
}

// One row per real payment event that settles a bill from an EARLIER
// month during a LATER month (a card's carried-forward debt paid off
// mid-cycle, or a plain recurring bill paid late). MonthlyEntry only ever
// keeps a cumulative isPaid/paidAmount snapshot, which can't tell "paid
// ₹198,000 total" apart from "₹114,000 of it in the bill's own month,
// ₹84,009 more two months later" — this table is the only place that
// records the actual per-event amount and when it happened, so Payables'
// "carried forward, settled this month" breakdown shows what really moved
// this month instead of the bill's whole original amount.
model CarriedDebtSettlement {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   LineItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  billMonth  Int
  billYear   Int
  amount     Float
  settledOn  DateTime         @default(now())
}

// Chit fund details — linked 1:1 to a LineItemTemplate
model ChitFund {
  id                    String           @id @default(cuid())
  templateId            String           @unique
  template              LineItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalValue            Float
  durationMonths        Int
  startDate             DateTime
  monthlyUnliftedAmount Float
  monthlyLiftedAmount   Float?
  isLifted              Boolean          @default(false)
  liftedOn              DateTime?
  liftedAmount          Float?
  liftedUsedFor         String?
  accumulatedSavings    Float            @default(0)
  endDate               DateTime?
  createdAt             DateTime         @default(now())
  // Real link to the lift-income AdHocItem, replacing a name-string match
  // ("{template.name} Chit Lifted") that broke if the template was renamed
  // after lifting, and that a typo in the delete-cleanup path never
  // actually matched (see backfill script run alongside this change).
  liftIncomeItemId      String?          @unique
  liftIncomeItem        AdHocItem?       @relation(fields: [liftIncomeItemId], references: [id], onDelete: SetNull)
}

// Credit card — linked 1:1 to a LineItemTemplate of category CREDIT_CARD
model CreditCard {
  id           String           @id @default(cuid())
  templateId   String           @unique
  template     LineItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank         String?
  network      String?          // "Visa" | "Mastercard" | "Rupay" | "Amex"
  last4        String?          // last 4 digits, used to auto-match Gmail-imported transactions
  createdAt    DateTime         @default(now())
  statements   CardStatement[]
}

// One row per card per billing cycle. The only stored credit-card state
// under the rework: what the bank actually billed (once confirmed), what
// was paid against it, and any cashback. Everything else on screen
// (unbilled spends, current balance, utilisation) is derived from these
// rows plus the card's AdHocItem charges (see src/lib/cards.ts, cardStatus).
model CardStatement {
  id               String     @id @default(cuid())
  cardId           String
  card             CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The cycle this statement covers: [cycleStart, statementDate).
  cycleStart       DateTime
  statementDate    DateTime   // the day the bank cut the bill
  paymentDueDate   DateTime
  // The bank's figure. Null while the cycle is only estimated from logged
  // charges; set (and thereafter never recomputed) once the user or a
  // parsed statement email confirms the real amount.
  statementBalance Float?
  confirmedAt      DateTime?
  confirmedVia     String?    // "manual" | "gmail"
  paidAmount       Float      @default(0)
  paidInFull       Boolean    @default(false)
  // When the payment was made, for the cash-balance view. Cleared on undo.
  paidAt           DateTime?
  cashback         Float      @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([cardId, statementDate])
  @@index([userId])
}

// One-off income or expense for a month
model AdHocItem {
  id                String          @id @default(cuid())
  monthId           String
  month             Month           @relation(fields: [monthId], references: [id], onDelete: Cascade)
  name              String
  amount            Float
  type              AdHocType
  category          Category?
  // Top-level user-created category (e.g. "Kids") — same convention as
  // LineItemTemplate.customCategory: category is forced to MISCELLANEOUS
  // when this is set, customCategory holds the real display name.
  customCategory    String?
  customCategoryId  String?
  customCategoryRef CustomCategory? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  // Sub-category, scoped under whichever of category/customCategoryId is
  // set on this row — e.g. Personal -> "Coffee". Plain string, not a
  // relation: suggestions are scoped by querying existing rows for the
  // same parent, not a normalized table (see resolveSubCategory).
  subCategory       String?
  // Authoritative link for CC statement math — replaces parsing the card
  // name out of the notes field, which broke if notes became user-editable.
  ccTemplateId      String?
  ccTemplate        LineItemTemplate? @relation(fields: [ccTemplateId], references: [id], onDelete: SetNull)
  // A credit/refund against a CC card (not a new charge) — amount is still
  // stored as a positive magnitude, this flags it to be netted OUT of the
  // card's statement total instead of added. Set by the Gmail-approve
  // flow (a detected refund) or by the manual dialog's "card repayment"
  // toggle (see isCardRepayment below) — always paired with ccTemplateId.
  isCredit          Boolean         @default(false)
  // Narrows isCredit to specifically "money paid toward the card's own
  // bill" (bank transfer/UPI/autopay settling what's owed) rather than a
  // merchant refund on a past purchase. The distinction matters because a
  // repayment isn't spending in any category — unlike a merchant refund,
  // which still nets sensibly against whatever category the original
  // purchase was in — so a repayment is excluded entirely from category
  // totals and the Daily Spend breakdown instead of just netting to zero
  // there. Always false unless isCredit is also true.
  isCardRepayment   Boolean         @default(false)
  date              DateTime
  notes             String?
  createdAt         DateTime        @default(now())
  // Back-reference for ChitFund.liftIncomeItemId — lets a chit's lift
  // income row be found by real FK instead of matching on a computed
  // "{template name} Chit Lifted" string, which broke silently if the
  // template was ever renamed.
  liftedByChit      ChitFund?
}

enum ReceivableCategory {
  INVESTMENT
  PERSONAL_LOAN
  CUSTOM
}

enum ReceivableStatus {
  PENDING
  RECEIVED
}

model Receivable {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        ReceivableCategory
  customCategory  String?
  // Links to the same CustomCategory table AdHocItem/LineItemTemplate use —
  // previously a plain unlinked string, so a "Kids" receivable never
  // converged with a "Kids" custom category created elsewhere (ad-hoc entry,
  // recurring template), and case variants didn't canonicalize either.
  customCategoryId  String?
  customCategoryRef CustomCategory?   @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  description     String
  expectedAmount  Float
  expectedDate    DateTime?
  status          ReceivableStatus   @default(PENDING)
  receivedAmount  Float?
  receivedDate    DateTime?
  receivedMonthId String?
  receivedMonth   Month?             @relation(fields: [receivedMonthId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// Web Push subscription per device
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())
}

// ─── Gmail transaction import ──────────────────────────────────────────────

// One per user — opt-in connection storing the OAuth token used to read
// (read-only) bank transaction alert emails. Separate from the NextAuth
// Account record so the sensitive gmail.readonly scope is only ever
// requested when a user explicitly opts in from Settings, not at sign-in.
model GmailConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String?
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  tokenExpiry  DateTime
  lastSyncAt   DateTime?
  connectedAt  DateTime  @default(now())
  historyId       String?
  watchExpiration DateTime?
  // Set the moment a sync actually hits an invalid/revoked refresh token
  // (Google's Testing-mode OAuth apps expire these after 7 days) — a
  // definitive "reconnect now" signal, not a guess from elapsed time.
  needsReauth     Boolean   @default(false)
  // Last time the proactive "reconnect soon" reminder fired for the
  // CURRENT token's lifecycle — reset on every reconnect so the next
  // 7-day cycle can remind again.
  reminderSentAt  DateTime?
  // Set to a short deadline while a sync is running, so several bank
  // emails arriving together (each firing a Pub/Sub webhook) don't kick
  // off overlapping syncs that race on historyId and waste Gemini quota.
  // A stale value (past) is ignored, so a crashed run never wedges sync.
  syncingUntil    DateTime?
}

enum ParsedTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParsedTransactionPaymentMethod {
  CREDIT_CARD
  UPI
  DEBIT_CARD
  OTHER
}

enum ParsedTransactionType {
  DEBIT
  CREDIT
  REFUND
}

// TRANSACTION: a card/UPI charge, refund, or bill payment, awaiting review
// to become an AdHocItem (or a card-statement payment). STATEMENT: a
// "your statement is generated" email, awaiting review to confirm the
// CardStatement balance for that cycle (see /api/cards/[cardId]/confirm).
enum ParsedTransactionKind {
  TRANSACTION
  STATEMENT
}

// A bank email Gemini identified as a transaction, awaiting the user's
// review before it becomes a real AdHocItem (and, for credit cards, a
// MonthlyEntry statement-math effect).
model ParsedTransaction {
  id                     String                          @id @default(cuid())
  userId                 String
  user                   User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId         String
  bank                   String
  amount                 Float
  originalCurrency       String?
  originalAmount         Float?
  merchant               String?
  last4                  String?
  date                   DateTime
  transactionTime        String?
  emailReceivedAt        DateTime?
  rawSnippet             String
  status                 ParsedTransactionStatus         @default(PENDING)
  kind                   ParsedTransactionKind           @default(TRANSACTION)
  paymentMethod          ParsedTransactionPaymentMethod  @default(CREDIT_CARD)
  transactionType        ParsedTransactionType           @default(DEBIT)
  suggestedCcTemplateId  String?
  suggestedSubcategory   String?
  // STATEMENT rows only: the payment due date parsed from the email.
  statementDueDate       DateTime?
  createdAt              DateTime                        @default(now())

  @@unique([userId, gmailMessageId])
}

// Remembers the category/sub-category a user actually picked for a given
// merchant, keyed by a normalized version of the merchant/payee string —
// so the next time the same payee shows up in a Gmail-sync suggestion (or
// a manual add), the review form starts from what they picked last time
// instead of Gemini's freeform guess or the generic Family default.
// Deliberately simple: last correction wins, no scoring/decay.
model MerchantCategoryMemory {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey       String
  category          Category?
  customCategoryId  String?
  customCategoryRef CustomCategory? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  subCategory       String?
  updatedAt         DateTime        @updatedAt

  @@unique([userId, merchantKey])
}

// Every Gmail message the sync has ever inspected, whether or not it turned
// into a ParsedTransaction — prevents re-fetching and re-sending the same
// non-transaction email (promos, OTPs, statements) to Gemini on every sync
// for as long as it stays inside the search window.
model GmailSeenMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  createdAt      DateTime @default(now())

  @@unique([userId, gmailMessageId])
}

// One row per actual Gemini API call made during sync (not per email — a
// batched call covering several emails is still one row, one token count).
// batchSize lets "emails sent to Gemini" and "API calls made" stay two
// distinct numbers instead of conflating them; promptTokens/candidatesTokens
// are stored raw so cost can be recomputed from an updated pricing table
// later without a data migration (see src/lib/gmail/gemini-usage.ts).
model GeminiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model            String
  batchSize        Int
  promptTokens     Int
  candidatesTokens Int
  // Gemini 2.5's internal reasoning tokens — billed as output tokens (same
  // rate as candidatesTokens) but reported separately. Defaults to 0 for
  // rows logged before this column existed; those are backfilled with an
  // estimate derived by re-running a sample of real historical emails
  // through the same prompt, not the exact original value (which was never
  // captured, so it isn't recoverable) — see scripts/backfill-thoughts-tokens.ts.
  thoughtsTokens   Int      @default(0)
  createdAt        DateTime @default(now())
}

// Self-tuning cost control: tracks how often mail from a given sender
// address turns out to actually be a transaction. A sender with a long
// enough "not a transaction" streak gets skipped before ever reaching
// Gemini — a single real transaction from that sender resets the streak,
// so a sender never gets permanently locked out on a fluke.
model GmailSenderReputation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail    String
  notTxnStreak   Int      @default(0)
  totalSeen      Int      @default(0)
  totalTxn       Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([userId, senderEmail])
}
